# Divyam Ayurveda - Client Environment Variables
VITE_APP_NAME="Divyam Ayurveda"
# Backend API address. Leave empty to call the same site's /api (production on divyamayurveda.in, and the Vite proxy locally).
# Set it only if the backend lives on a different address.
VITE_API_URL=

# Meta Ads Pixel (optional). Leave empty to switch the Pixel off.
VITE_META_PIXEL_ID=
