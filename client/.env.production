# Production Environment Configuration for Divyam Ayurveda Frontend
# VITE_API_URL is intentionally empty: the storefront calls its own backend at the same address (/api/...), so
# both divyamayurveda.in and www.divyamayurveda.in work. Set it only if the backend lives on a different address.
VITE_API_URL=
VITE_APP_NAME="Divyam Ayurveda"
